# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# wrangler
.wrangler/
.dev.vars

# claude-mem per-directory memory — internal only. Never let these become Astro
# routes (any CLAUDE.md under src/pages/ would be served as a page + sitemapped).
src/pages/**/CLAUDE.md

# Del knowledge se ignora SOLO lo generado: los `.snap.md` los rehace
# `office watch` en cada pasada. Las narrativas son CONTRATO y viajan en git
# — gitignorearlas enteras dejaba el contrato viviendo en una sola máquina
# (doctrina de la office, aprendido en el piloto de ui del 27-ago).
knowledge/*.snap.md
