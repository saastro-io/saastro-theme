---
/**
 * BaseLayout — pure HTML shell
 *
 * Handles: SEO meta, OG, Twitter, analytics, dark mode, View Transitions.
 * Does NOT include Header, Footer, or Announcement — use SiteLayout for that.
 *
 * Use this directly when building custom layouts (blog, docs, minimal, etc.)
 */
import '../styles/global.css';
import ApplyColorMode from '../scripts/ApplyColorMode.astro';
import Favicons from '../head/Favicons.astro';
import LocalBusinessJsonLd from '../components/LocalBusinessJsonLd.astro';
import SiteJsonLd from '../components/SiteJsonLd.astro';
import Analytics from '../components/Analytics.astro';
import GenTracking from '../components/GenTracking.astro';
import { ClientRouter } from 'astro:transitions';
import { locales, defaultLocale } from '../i18n/config';
import { getHreflangEntries, stripLocalePrefix } from '../i18n/utils';
import { getSettings } from '../lib/settings';
import { resolveSiteName } from '../lib/brand';
import { resolveTracking, describeRejected, type LandingTracking } from '../lib/tracking';

const settings = getSettings();

export interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  lang?: string;
  ogType?: string;
  /** Vista previa de un borrador: `noindex, nofollow` y fuera del índice. */
  noindex?: boolean;
  /** `false` = `noindex, follow` SIN apagar la medición (p. ej. la página de gracias, que
   *  los píxeles necesitan). `noindex` (vista previa) sí lo apaga todo: su URL lleva un token. */
  indexable?: boolean;
  /** `false` = sin alternates hreflang (contenido de un solo idioma, p. ej. una landing). */
  alternates?: boolean;
  googleSiteVerificationId?: string;
  analytics?: {
    googleAnalyticsId?: string;
    googleTagManagerId?: string;
  };
  /** Override de píxeles de la landing que se sirve (frontmatter `tracking:` +
   *  `trackingMode:`). SiteLayout lo recibe por esta misma prop y lo pasa a SU
   *  `resolveTracking` con las mismas opciones: banner y cargador ven la MISMA lista. */
  landingTracking?: LandingTracking;
}

// Use locale from middleware if i18n is enabled, fallback to prop
const localsLang = Astro.locals.lang;

const {
  title,
  description = settings.metadata.description ?? 'A Saastro theme',
  image = '/og-image.png',
  canonicalUrl,
  lang = localsLang ?? defaultLocale,
  ogType = 'website',
  noindex = false,
  indexable = true,
  alternates = true,
  googleSiteVerificationId,
  analytics = {},
  landingTracking,
} = Astro.props;

const resolvedGoogleSiteVerificationId =
  googleSiteVerificationId ?? settings.site.googleSiteVerificationId;
// Un solo resolvedor (src/lib/tracking.ts) para BaseLayout y SiteLayout: ids
// validados por formato, `noindex` (vista previa de un borrador) lo apaga todo.
const tracking = resolveTracking(settings, {
  noindex,
  overrides: { googleAnalyticsId: analytics.googleAnalyticsId, googleTagManagerId: analytics.googleTagManagerId },
  landing: landingTracking,
});
for (const r of tracking.rejected) console.warn(describeRejected(r));
const themeColor = settings.site.favicon.colors.theme ?? '#00a897';
// `noindex` = vista previa de un borrador: su URL lleva un token (`?preview=`),
// y GA, GTM, el beacon de CF y el de Gen mandan la URL completa. Ninguno carga
// (resolveTracking con `noindex` ya lo apaga todo, Cloudflare incluido).
// SAASTRO Gen attribution beacon — renders only when the Hub (or the operator)
// wired a Gen workspace into settings.gen. GenTracking itself host-blocks the
// Studio preview + local dev, mirroring the CF Web Analytics guard in Analytics.astro.
const genWorkspaceId = noindex ? '' : (settings.gen?.workspaceId ?? '');
const genVertical = settings.gen?.vertical || 'default';
const genConsent = settings.gen?.consent === 'required' ? 'required' : 'none';
// Brand name for og:site_name — from i18n `meta.siteName` (Hub-editable),
// falling back to the build-time settings value.
const siteName = resolveSiteName(Astro.locals);

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const canonical = canonicalUrl ?? `${siteUrl}${Astro.url.pathname}`;
const ogImage = image.startsWith('http') ? image : `${siteUrl}${image}`;
// `alternates={false}` para contenido que existe en UN solo idioma (las landings: un .md
// por slug, servido igual bajo cualquier prefijo): un alternate hacia una traducción que no
// existe es una señal falsa para el buscador.
const hreflangEntries =
  alternates && locales.length > 1 ? getHreflangEntries(stripLocalePrefix(Astro.url.pathname)) : [];
// x-default = la versión del idioma por defecto (antes: la propia página, fuese cual fuese).
const xDefaultHref = hreflangEntries.find((e) => e.locale === defaultLocale)?.href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && !indexable && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {hreflangEntries.map(({ locale, href }) => (
      <link rel="alternate" hreflang={locale} href={`${siteUrl}${href}`} />
    ))}
    {hreflangEntries.length > 0 && xDefaultHref && (
      <link rel="alternate" hreflang="x-default" href={`${siteUrl}${xDefaultHref}`} />
    )}

    <link rel="preconnect" href="/" crossorigin />
    <meta name="theme-color" content={themeColor} />
    <link rel="manifest" href="/manifest.json" />

    <Favicons />
    <SiteJsonLd
      siteUrl={siteUrl}
      siteName={siteName}
      description={description}
      image={ogImage}
    />
    <LocalBusinessJsonLd />
    {resolvedGoogleSiteVerificationId && (
      <meta name="google-site-verification" content={resolvedGoogleSiteVerificationId} />
    )}
    <ApplyColorMode />
    <Analytics
      providers={tracking.providers}
      googleAdsConversionLabel={tracking.googleAdsConversionLabel}
      googleAdsConversions={tracking.googleAdsConversions}
    />
    <ClientRouter fallback="swap" />

    <slot name="head" />

    {/* Cloudflare Web Analytics ya NO se carga aquí: es un proveedor más del catálogo
        (`cloudflareWebAnalytics`, categoría `none` = exento de consentimiento, con su
        motivo escrito en tracking-providers.json) y lo carga el ÚNICO cargador,
        Analytics.astro, con el mismo bloqueo de hosts y el mismo shim de siempre. */}

    {/* SAASTRO Gen lead attribution — cookieless page-view beacon + visitor id
        on form submits. Off unless settings.gen.workspaceId is set (the Hub's
        per-site "Gen tracking" toggle writes it). */}
    {genWorkspaceId && (
      <GenTracking workspaceId={genWorkspaceId} vertical={genVertical} consent={genConsent} trackingKeys={tracking.consentKeys} />
    )}
  </head>

  <body>
    <a href="#main-content" class="skip-to-content">Skip to content</a>
    {/* Sin <noscript> de GTM: sin JS el visitante no puede dar consentimiento, y el iframe
        de ns.html cargaba el contenedor igualmente. Quien no ejecuta JS no se mide. */}
    <slot />
  </body>
</html>
