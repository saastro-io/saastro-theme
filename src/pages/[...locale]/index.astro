---
import { locales, defaultLocale, type Locale } from '../../i18n/config';
import { resolveMeta } from '../../i18n/meta';
import SiteLayout from '../../layouts/SiteLayout.astro';
import HomeHero from '../../components/home/HomeHero.astro';
import ProofStrip from '../../components/home/ProofStrip.astro';
import ProblemGrid from '../../components/home/ProblemGrid.astro';
import HomeSteps from '../../components/home/HomeSteps.astro';
import FeatureGrid from '../../components/home/FeatureGrid.astro';
import CompareRows from '../../components/home/CompareRows.astro';
import FaqList from '../../components/home/FaqList.astro';
import RequestSite from '../../components/home/RequestSite.astro';
import FinalCta from '../../components/home/FinalCta.astro';
// El DS de Saastro, SOLO en esta página: ver la cabecera de home-ds.css.
import '../../styles/home-ds.css';

export const prerender = true;

// Default locale renders at the root (`/`); other locales are prefixed (`/es/…`).
// The optional rest param `[...locale]` lets one page tree serve both.
export function getStaticPaths() {
  return locales.map((locale) => ({
    params: { locale: locale === defaultLocale ? undefined : locale },
  }));
}

/**
 * La home de theme.saastro.io es el escaparate COMERCIAL del servicio de site
 * a medida, con el DS de Saastro (diseño de Claude Design, 5-oct-2026).
 *
 * Para un descendiente esta página es contenido (`merge=ours` en
 * .gitattributes): se queda con su portada. Las secciones de ejemplo de
 * siempre (`Hero`, `Products`, `TrustBar`…) siguen en `src/components/` para
 * los sites que las usan; esta home ya no las monta. Las suyas viven en
 * `src/components/home/` y son LOCALES —el porqué de cada una, en su
 * cabecera—: lo que cruza a un bloque del registry no es editable desde Studio.
 *
 * Los `??` son el mínimo para que la página construya si alguien poda un
 * namespace del JSON; no son contenido.
 */
const t = Astro.locals.t as any;
const lang = Astro.locals.lang as Locale;
const BLOCKS = 'https://ui.saastro.io';
const CONTACT = '#contact';

const hero = t?.hero ?? { title: 'Saastro Theme', subtitle: '', primaryCta: 'Contact', mock: null };
const proof = t?.proof ?? { items: [] };
const problem = t?.problem ?? { title: '', items: [] };
const how = t?.how ?? { title: '', steps: [] };
const features = t?.features ?? { title: '', items: [] };
const compare = t?.compare ?? { title: '', labelUs: '', labelThem: '', labelThemShort: '', rows: [] };
const faq = t?.faq ?? { title: '', items: [] };
const contact = t?.contact ?? { title: '', notConnected: '' };
const final = t?.final ?? { title: '', primaryCta: 'Contact' };

const meta = resolveMeta(t, 'home');
---

<SiteLayout title={meta.title ?? 'Saastro Theme'} description={meta.description} image={meta.ogImage}>
  <div class="ds-home">
    <HomeHero
      eyebrow={hero.eyebrow}
      title={hero.title}
      titleMuted={hero.titleMuted}
      subtitle={hero.subtitle}
      primaryCta={hero.primaryCta}
      primaryHref={CONTACT}
      secondaryCta={hero.secondaryCta}
      secondaryHref={BLOCKS}
      mockNote={hero.mockNote}
      mock={hero.mock}
      fieldPrefix="hero"
    />

    <ProofStrip items={proof.items} fieldPrefix="proof" />

    <ProblemGrid eyebrow={problem.eyebrow} title={problem.title} items={problem.items} fieldPrefix="problem" />

    <HomeSteps eyebrow={how.eyebrow} title={how.title} steps={how.steps} fieldPrefix="how" />

    <FeatureGrid
      eyebrow={features.eyebrow}
      title={features.title}
      description={features.description}
      items={features.items}
      fieldPrefix="features"
    />

    <CompareRows
      eyebrow={compare.eyebrow}
      title={compare.title}
      labelUs={compare.labelUs}
      labelThem={compare.labelThem}
      labelThemShort={compare.labelThemShort}
      rows={compare.rows}
      fieldPrefix="compare"
    />

    <FaqList
      eyebrow={faq.eyebrow}
      title={faq.title}
      askPrefix={faq.askPrefix}
      askLink={faq.askLink}
      askHref={CONTACT}
      items={faq.items}
      fieldPrefix="faq"
    />

    <RequestSite
      eyebrow={contact.eyebrow}
      title={contact.title}
      description={contact.description}
      points={contact.points}
      notConnected={contact.notConnected}
      locale={lang}
      fieldPrefix="contact"
    />

    <FinalCta
      eyebrow={final.eyebrow}
      title={final.title}
      code={final.code}
      primaryCta={final.primaryCta}
      primaryHref={CONTACT}
      secondaryCta={final.secondaryCta}
      secondaryHref={BLOCKS}
      fieldPrefix="final"
    />
  </div>
</SiteLayout>
