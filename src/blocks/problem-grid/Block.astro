---
/** Bloque `problem-grid`: envuelve `components/home/ProblemGrid.astro`. */
import Envoltura from '../Envoltura.astro';
import ProblemGrid from '../../components/home/ProblemGrid.astro';
import type { ProblemGridProps } from './schema';

interface Props {
  id: string;
  variant?: string;
  props: ProblemGridProps;
  tema?: string;
  locale?: string;
}

const { id, tema, props } = Astro.props;
const { tono, alineacion, espaciado, columnas, ...resto } = props;
---

<Envoltura id={id} tema={tema} estilo={{ tono, alineacion, espaciado, columnas }}>
  <ProblemGrid {...resto} />
</Envoltura>
