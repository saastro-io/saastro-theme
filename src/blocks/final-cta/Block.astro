---
/** Bloque `final-cta`: envuelve `components/home/FinalCta.astro`. */
import Envoltura from '../Envoltura.astro';
import FinalCta from '../../components/home/FinalCta.astro';
import type { FinalCtaProps } from './schema';

interface Props {
  id: string;
  variant?: string;
  props: FinalCtaProps;
  tema?: string;
  locale?: string;
}

const { id, tema, props } = Astro.props;
const { primaryCta, secondaryCta, tono, alineacion, espaciado, ...resto } = props;
---

<Envoltura id={id} tema={tema} estilo={{ tono, alineacion, espaciado }}>
  <FinalCta
    {...resto}
    primaryCta={primaryCta.label}
    primaryHref={primaryCta.href}
    secondaryCta={secondaryCta?.label}
    secondaryHref={secondaryCta?.href}
  />
</Envoltura>
