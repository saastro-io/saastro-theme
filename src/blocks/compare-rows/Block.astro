---
/** Bloque `compare-rows`: envuelve `components/home/CompareRows.astro`. */
import Envoltura from '../Envoltura.astro';
import CompareRows from '../../components/home/CompareRows.astro';
import type { CompareRowsProps } from './schema';

interface Props {
  id: string;
  variant?: string;
  props: CompareRowsProps;
  tema?: string;
  locale?: string;
}

const { id, tema, props } = Astro.props;
const { tono, alineacion, espaciado, ...resto } = props;
---

<Envoltura id={id} tema={tema} estilo={{ tono, alineacion, espaciado }}>
  <CompareRows {...resto} />
</Envoltura>
