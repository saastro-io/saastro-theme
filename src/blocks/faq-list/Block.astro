---
/** Bloque `faq-list`: envuelve `components/home/FaqList.astro`. */
import Envoltura from '../Envoltura.astro';
import FaqList from '../../components/home/FaqList.astro';
import type { FaqListProps } from './schema';

interface Props {
  id: string;
  variant?: string;
  props: FaqListProps;
  tema?: string;
  locale?: string;
}

const { id, tema, props } = Astro.props;
const { tono, alineacion, espaciado, ...resto } = props;
---

<Envoltura id={id} tema={tema} estilo={{ tono, alineacion, espaciado }}>
  <FaqList {...resto} fieldPrefix="" />
</Envoltura>
