---
/** Bloque `features`: envuelve `FeatureGrid` con las props de estilo comunes. */
import '@/styles/home-ds.css';
import { sec } from '@saastro/studio/pages';
import FeatureGrid from '@/components/home/FeatureGrid.astro';
import { claseBloque } from '../estilo';
import type { FeaturesProps } from './schema';

interface Props {
  id: string;
  variant?: string;
  props: FeaturesProps;
  tema?: string;
  locale?: string;
}

const { id, tema, props } = Astro.props;
const { tono, alineacion, espaciado, columnas, ...resto } = props;
---

<div {...sec(id, tema)} class={claseBloque('features', { tono, alineacion, espaciado, columnas })}>
  <FeatureGrid {...resto} />
</div>
