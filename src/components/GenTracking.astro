---
/**
 * GenTracking — SAASTRO Gen lead-attribution beacon (opt-in).
 *
 * Emits one page-view to `{endpoint}/collect` per page load, keyed by an
 * anonymous `visitorId` kept in **sessionStorage**, and injects that id into
 * every `<form>` as a hidden field
 * `gen_visitor_id`. When the form is submitted the id rides along, so Gen can
 * link the lead back to its pre-conversion journey → first/last-touch
 * attribution + funnel/CPL per channel.
 *
 * PUBLIC config only (like a GA measurement id) — `workspaceId`/`vertical`
 * merely attribute page-views; no secret travels in the browser. Spoofing is
 * bounded server-side by a per-IP+visitor rate-limit.
 *
 * NOT wired into BaseLayout by default — include it explicitly per site so no
 * one is tracked by accident:
 *
 *   import GenTracking from '../components/GenTracking.astro';
 *   <GenTracking workspaceId="team_123" vertical="realestate" />
 *
 * Consent modes:
 *   consent="required"  (default) NOTHING happens until the visitor accepts the
 *                       `analytics` category of the cookie banner: no
 *                       sessionStorage id, no form field, no request. The banner
 *                       mirrors that choice into localStorage['gen-consent']
 *                       (src/lib/gen-consent.ts) and the cookie `cookie_consent`
 *                       must also COVER the providers switched on
 *                       (`trackingKeys`; same rule as Analytics.astro,
 *                       consentCovers in src/lib/cookies.ts). Rejecting or
 *                       revoking deletes the id and the hidden form fields.
 *   consent="none"      explicit opt-out: tracks immediately. Only for a site
 *                       whose owner has decided the beacon is exempt — the
 *                       theme does NOT assume it (art. 22.2 LSSI / ePrivacy 5(3)
 *                       cover any storage on the device, not only cookies).
 */
export interface Props {
  /** Gen workspace id = the SAASTRO Platform team id (public). */
  workspaceId: string;
  /** Product surface within the workspace (free string). Default: "default". */
  vertical?: string;
  /** Gen collector origin. Default: https://gen.saastro.io */
  endpoint?: string;
  /** "required" (default, gated on the cookie banner) | "none" (immediate). */
  consent?: 'none' | 'required';
  /** Claves de los proveedores de tracking encendidos (resolveTracking). Con
   *  consent="required" el consentimiento guardado debe cubrirlas todas. */
  trackingKeys?: string[];
}

const {
  workspaceId,
  vertical = 'default',
  endpoint = 'https://gen.saastro.io',
  consent = 'required',
  trackingKeys = [],
} = Astro.props;
// Host propio del site (`SITE_URL`): se mide aunque cuelgue de *.saastro.io.
const ownHost = Astro.site?.hostname ?? '';
---

{workspaceId && (
  <script
    is:inline
    data-gen-workspace={workspaceId}
    data-gen-vertical={vertical}
    data-gen-endpoint={endpoint}
    data-gen-consent={consent}
    data-gen-own-host={ownHost}
    data-gen-keys={JSON.stringify(trackingKeys)}
  >
    (function () {
      try {
        var el =
          document.currentScript || document.querySelector('script[data-gen-workspace]');
        var cfg = (el && el.dataset) || {};
        var workspace = cfg.genWorkspace;
        if (!workspace) return;
        var vertical = cfg.genVertical || 'default';
        var endpoint = (cfg.genEndpoint || 'https://gen.saastro.io').replace(/\/+$/, '');
        // Ausente o desconocido = «required»: solo un «none» escrito a propósito
        // se salta el banner.
        var consentMode = cfg.genConsent === 'none' ? 'none' : 'required';
        var ownHost = cfg.genOwnHost || '';
        var KEYS = [];
        try { KEYS = JSON.parse(cfg.genKeys || '[]'); } catch (e) { KEYS = []; }
        if (!Array.isArray(KEYS)) KEYS = [];

        // Never track editor previews / local dev — the Studio preview proxy
        // serves the site under a *.saastro.io origin, and localhost is dev.
        // The site's own host (SITE_URL) is real traffic even under saastro.io.
        var h = location.hostname;
        if (
          h === 'localhost' ||
          h === '127.0.0.1' ||
          (h.endsWith('.saastro.io') && h !== ownHost) ||
          h.endsWith('.saastro.test') ||
          h.endsWith('.local')
        )
          return;

        // REPLICA de consentCovers (src/lib/cookies.ts) sobre la cookie del banner:
        // un consentimiento que no cubre los proveedores de hoy no vale, aunque
        // `gen-consent` siga en 'granted' (el banner lo retira al montar, pero
        // esta carga ya empezó). Analytics.test.ts ejecuta este código
        // contra la función pura.
        function cookieCovers() {
          try {
            var match = document.cookie.split('; ').find(function (c) { return c.indexOf('cookie_consent=') === 0; });
            if (!match) return false;
            var c = JSON.parse(decodeURIComponent(match.split('=').slice(1).join('=')));
            if (!c || typeof c !== 'object') return false;
            if (KEYS.length === 0) return true;
            if (!Array.isArray(c.providers)) return false;
            return KEYS.every(function (k) { return c.providers.indexOf(k) !== -1; });
          } catch (e) {
            return false;
          }
        }

        // La cookie manda: un `gen-consent` 'granted' que sobrevive a una cookie
        // con analytics:false (otro CMP, edición manual) NO concede nada.
        function cookieAnalyticsOn() {
          try {
            var match = document.cookie.split('; ').find(function (c) { return c.indexOf('cookie_consent=') === 0; });
            if (!match) return false;
            var c = JSON.parse(decodeURIComponent(match.split('=').slice(1).join('=')));
            return !!c && c.analytics === true;
          } catch (e) {
            return false;
          }
        }

        function consentOk() {
          if (consentMode !== 'required') return true;
          try {
            return localStorage.getItem('gen-consent') === 'granted' && cookieAnalyticsOn() && cookieCovers();
          } catch (e) {
            return false;
          }
        }

        // Retirada: borra el id de la pestaña y los campos ocultos ya
        // inyectados, para que un envío posterior no lo lleve.
        function forget() {
          try {
            sessionStorage.removeItem('gen-visitor-id');
          } catch (e) {}
          try {
            var inputs = document.querySelectorAll('input[name="gen_visitor_id"]');
            for (var i = 0; i < inputs.length; i++) inputs[i].remove();
          } catch (e) {}
        }

        function uuid() {
          try {
            if (window.crypto && crypto.randomUUID) return crypto.randomUUID();
          } catch (e) {}
          return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
            var r = (Math.random() * 16) | 0;
            var v = c === 'x' ? r : (r & 0x3) | 0x8;
            return v.toString(16);
          });
        }

        function visitorId() {
          try {
            var k = 'gen-visitor-id';
            var v = sessionStorage.getItem(k);
            if (!v) {
              v = uuid();
              sessionStorage.setItem(k, v);
            }
            return v;
          } catch (e) {
            return null; // storage blocked → stay anonymous, don't track
          }
        }

        function parseUtm() {
          try {
            var p = new URLSearchParams(location.search);
            var out = {};
            var keys = ['source', 'medium', 'campaign', 'term', 'content'];
            for (var i = 0; i < keys.length; i++) {
              var val = p.get('utm_' + keys[i]);
              if (val) out[keys[i]] = String(val).slice(0, 200);
            }
            return Object.keys(out).length ? out : undefined;
          } catch (e) {
            return undefined;
          }
        }

        function injectForms(vid) {
          try {
            var forms = document.getElementsByTagName('form');
            for (var i = 0; i < forms.length; i++) {
              var f = forms[i];
              var input = f.querySelector('input[name="gen_visitor_id"]');
              if (input) {
                input.value = vid;
                continue;
              }
              input = document.createElement('input');
              input.type = 'hidden';
              input.name = 'gen_visitor_id';
              input.value = vid;
              f.appendChild(input);
            }
          } catch (e) {}
        }

        function send(vid) {
          try {
            var body = {
              workspaceId: workspace,
              vertical: vertical,
              visitorId: vid,
              type: 'page_view',
              url: location.href,
              path: location.pathname,
              referrer: document.referrer || undefined,
              utm: parseUtm(),
              title: document.title || undefined,
              ts: Date.now(),
            };
            var json = JSON.stringify(body);
            var url = endpoint + '/collect';
            // sendBeacon con Blob text/plain A PROPÓSITO (no application/json):
            // un beacon cross-origin con content-type no safelisted exige un
            // preflight que sendBeacon no puede hacer — Chrome lo BLOQUEA por
            // CORS pero devuelve `true`, así que el fallback nunca corría y el
            // evento moría en silencio. Ese fue el bug de los «cero page_view
            // jamás» (30-jul-2026). text/plain es simple request (sin
            // preflight) y el colector parsea el JSON sin mirar el header.
            if (navigator.sendBeacon) {
              var blob = new Blob([json], { type: 'text/plain;charset=UTF-8' });
              if (navigator.sendBeacon(url, blob)) return;
            }
            fetch(url, {
              method: 'POST',
              // También simple request: mismo motivo, y así los dos caminos
              // se comportan igual ante el colector.
              headers: { 'content-type': 'text/plain;charset=UTF-8' },
              body: json,
              keepalive: true,
              mode: 'cors',
              credentials: 'omit',
            }).catch(function () {});
          } catch (e) {}
        }

        // Solo RETIRA: si el consentimiento ya no vale, olvida el id y los campos.
        function revalidate() {
          if (consentMode === 'required' && !consentOk()) forget();
        }

        var lastUrl = '';
        var lastTs = 0;
        function track() {
          if (!consentOk()) {
            // Sin consentimiento no se deja nada, ni siquiera un id viejo.
            if (consentMode === 'required') forget();
            return;
          }
          var vid = visitorId();
          if (!vid) return;
          // Always (re)inject — forms are swapped on SPA navigation.
          injectForms(vid);
          // Collapse the initial double-fire (astro:page-load + DOMContentLoaded)
          // without dropping genuine navigations to other URLs.
          var here = location.pathname + location.search;
          var now = Date.now();
          if (here === lastUrl && now - lastTs < 1000) return;
          lastUrl = here;
          lastTs = now;
          send(vid);
        }

        // Astro View Transitions: fires on initial load AND every SPA nav.
        document.addEventListener('astro:page-load', track);
        // Non-Astro fallback (portable drop-in): fire once if page-load never comes.
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', track);
        } else {
          track();
        }
        // Consent granted later → start tracking (same tab via custom event,
        // other tabs via the storage event).
        if (consentMode === 'required') {
          try {
            window.addEventListener('storage', function (e) {
              if (!e || e.key !== 'gen-consent') return;
              // Concedido en otra pestaña → medir; retirado en otra pestaña
              // (newValue null) → olvidar aquí también, sin enviar nada.
              if (e.newValue === 'granted') track();
              else revalidate();
            });
            // Página restaurada desde bfcache: no hay page-load ni DOMContentLoaded.
            window.addEventListener('pageshow', function (e) {
              if (e && e.persisted) revalidate();
            });
            window.addEventListener('gen:consent-granted', function () {
              track();
            });
            // El banner avisa en cada decisión. Medir al CONCEDER ya lo hace
            // `gen:consent-granted`; aquí solo se retira lo que ya no vale, sin
            // volver a contar la visita al re-guardar preferencias.
            window.addEventListener('cookie-consent-updated', function () {
              revalidate();
            });
          } catch (e) {}
        }
      } catch (e) {}
    })();
  </script>
)}
