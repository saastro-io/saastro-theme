---
import Img from '@saastro/studio/Img.astro';
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';
import { Badge } from '@/components/ui/badge';

interface Props {
  eyebrow?: string;
  title: string[];
  subtitle: string;
  image?: string;
  imageAlt?: string;
  stats?: { value: string; label: string }[];
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  fieldPrefix?: string;
}

const {
  eyebrow,
  title,
  subtitle,
  image,
  imageAlt = '',
  stats,
  primaryCta,
  secondaryCta,
  fieldPrefix = 'hero',
} = Astro.props;

// Dos modos, y ninguno depende de colores invertidos:
// - CON imagen: la sección lleva la clase `dark`, así que todo lo de dentro usa
// los tokens oscuros (texto claro, botones de modo oscuro) sobre un velo
// `bg-background/70`. Se lee igual en claro y en oscuro: la foto manda.
// - SIN imagen: superficie normal (`bg-muted/40`, texto `foreground`), sin la
// altura de 85vh que solo tiene sentido para enseñar una foto.
// Antes era `bg-foreground` + `text-primary-foreground`: en oscuro el bloque se
// volvía blanco y los CTA salían blanco sobre blanco / negro sobre negro.
---

<section
  class:list={[
    'relative flex flex-col overflow-hidden text-foreground',
    image
      ? 'dark min-h-[85vh] justify-end pb-16 pt-32 lg:pb-24'
      : 'bg-muted/40 pb-16 pt-16 lg:pb-24 lg:pt-24',
  ]}
>
  {image && (
    <>
      <Img
        src={image}
        alt={imageAlt}
        fieldPrefix={`${fieldPrefix}.image`}
        width={1920}
        height={1080}
        sizes="100vw"
        class="absolute inset-0 h-full w-full object-cover"
        loading="eager"
        fetchpriority="high"
        raw={!/^https?:\/\//.test(image)}
      />
      <div class="absolute inset-0 bg-background/70"></div>
    </>
  )}

  <div class="relative z-10 container mx-auto px-6 lg:px-12">
    {eyebrow && (
      <Badge variant="secondary" className="mb-6 text-xs tracking-wider uppercase">
        {eyebrow}
      </Badge>
    )}

    <h1 class="font-bold tracking-tight leading-[1.05]">
      {title.map((line) => (
        <span class="block text-[clamp(2.5rem,8vw,5.5rem)]">{line}</span>
      ))}
    </h1>

    <p class="mt-6 max-w-lg text-lg text-muted-foreground leading-relaxed">
      {subtitle}
    </p>

    {(primaryCta || secondaryCta) && (
      <div class="mt-8 flex flex-wrap gap-3">
        {primaryCta && (
          <a href={primaryCta.href} class={cn(buttonVariants(), 'h-9')}>
            {primaryCta.label}
          </a>
        )}
        {secondaryCta && (
          <a href={secondaryCta.href} class={cn(buttonVariants({ variant: 'outline' }), 'h-9')}>
            {secondaryCta.label}
          </a>
        )}
      </div>
    )}

    {stats && stats.length > 0 && (
      <div class="mt-12 border-t border-border pt-10 grid grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-12">
        {stats.map((stat) => (
          <div>
            <p class="text-3xl lg:text-4xl font-bold tracking-tight">
              {stat.value}
            </p>
            <p class="mt-1 text-xs uppercase tracking-wider text-muted-foreground">
              {stat.label}
            </p>
          </div>
        ))}
      </div>
    )}
  </div>
</section>
