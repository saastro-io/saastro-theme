---
export interface Props {
  googleAnalyticsId?: string;
  googleTagManagerId?: string;
}

const { googleAnalyticsId, googleTagManagerId } = Astro.props;
const hayGoogle = Boolean(googleAnalyticsId || googleTagManagerId);
---

{/* Google (GA4 y/o GTM) — UNA sola puerta de consentimiento y Consent Mode v2.

    Antes había dos IIFE casi idénticas (una por producto) con su propio
    `hasConsent`; ahora una sola lee la cookie `cookie_consent` del banner
    (src/lib/cookies.ts) y decide.

    Consent Mode v2: antes de cargar NINGÚN script de Google se declara todo
    `denied`; al aceptar (o si ya estaba aceptado) se hace `update`.
      analytics  → analytics_storage
      marketing  → ad_storage + ad_user_data + ad_personalization
    GA4 se carga solo con `analytics`. GTM se carga con `analytics` O
    `marketing` (un contenedor puede llevar solo etiquetas de anuncios); lo que
    cada etiqueta puede hacer lo limita Consent Mode.

    Revocar no se puede "descargar": el banner recarga la página si un tracker
    estaba vivo (CookieBanner.tsx → consentRevoked). */}
{hayGoogle && (
  <script is:inline define:vars={{ gaId: googleAnalyticsId ?? '', gtmId: googleTagManagerId ?? '' }}>
    (function () {
      function readConsent() {
        try {
          var match = document.cookie.split('; ').find(function (c) { return c.indexOf('cookie_consent=') === 0; });
          if (!match) return {};
          var c = JSON.parse(decodeURIComponent(match.split('=').slice(1).join('=')));
          return { analytics: c.analytics === true, marketing: c.marketing === true };
        } catch (e) {
          return {};
        }
      }
      function mode(v) { return v ? 'granted' : 'denied'; }

      window.dataLayer = window.dataLayer || [];
      function gtag() { window.dataLayer.push(arguments); }
      window.gtag = window.gtag || gtag;

      // 1) Todo denegado ANTES de cualquier script de Google.
      gtag('consent', 'default', {
        analytics_storage: 'denied',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        wait_for_update: 500,
      });

      function update(c) {
        gtag('consent', 'update', {
          analytics_storage: mode(c.analytics),
          ad_storage: mode(c.marketing),
          ad_user_data: mode(c.marketing),
          ad_personalization: mode(c.marketing),
        });
      }

      function loadGa() {
        if (!gaId || window.gaLoaded) return;
        window.gaLoaded = true;
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(gaId);
        document.head.appendChild(s);
        gtag('js', new Date());
        gtag('config', gaId);
      }

      function loadGtm() {
        if (!gtmId || window.gtmLoaded) return;
        window.gtmLoaded = true;
        window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var f = document.getElementsByTagName('script')[0];
        var j = document.createElement('script');
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + encodeURIComponent(gtmId);
        f.parentNode.insertBefore(j, f);
      }

      function apply(c) {
        if (!c.analytics && !c.marketing) return;
        update(c);
        if (c.analytics) loadGa();
        if (c.analytics || c.marketing) loadGtm();
      }

      function start() {
        apply(readConsent());
        window.addEventListener('cookie-consent-updated', function (e) {
          var d = (e && e.detail) || {};
          apply({ analytics: d.analytics === true, marketing: d.marketing === true });
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', start);
      } else {
        start();
      }
    })();
  </script>
)}
