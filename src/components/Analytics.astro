---
import type { EnabledProvider } from '../lib/tracking';

export interface Props {
  /** Proveedores ya validados por `resolveTracking` (src/lib/tracking.ts). */
  providers?: EnabledProvider[];
  /** Etiqueta de conversión de Google Ads (`AW-…/<label>`); '' = sin conversión. */
  googleAdsConversionLabel?: string;
}

const { providers = [], googleAdsConversionLabel = '' } = Astro.props;
---

{/* Medición y anuncios — UNA sola puerta de consentimiento para todos.

    Los ids ya vienen validados (formato) desde resolveTracking: aquí solo se
    serializan. Nada carga hasta que la cookie `cookie_consent` del banner
    (src/lib/cookies.ts) lo permite:
      analytics → GA4, Clarity
      marketing → Google Ads, Meta, TikTok, LinkedIn
      any       → GTM (con analytics o con marketing)
    Consent Mode v2: `default denied` ANTES de cargar nada de Google; `update`
    al aceptar (analytics → analytics_storage; marketing → ad_storage,
    ad_user_data, ad_personalization).

    VERSIÓN del consentimiento: la cookie guarda `providers` (los proveedores
    encendidos al consentir). Si hoy hay uno que no está, el consentimiento NO
    vale: no carga nada y el banner vuelve a preguntar (consentCovers).

    Revocar no se puede "descargar": el banner recarga la página si hay un
    tracker vivo (CookieBanner.tsx → consentRevoked; flag window.trackersLoaded).

    window.saastroTrack(evento, datos): único punto para emitir eventos de
    conversión. Solo llega a los proveedores YA cargados (o sea, con
    consentimiento); sin consentimiento no hace nada y devuelve []. El
    `event_id` que reciba en `datos` viaja a Meta (eventID) y TikTok (event_id)
    para poder deduplicar contra una API de conversiones de servidor.

    Los snippets de cada proveedor son los de su documentación pública, escritos
    de memoria: SIN VERIFICAR contra los proveedores reales (ver el PR). */}
{providers.length > 0 && (
  <script is:inline define:vars={{ providers, adsLabel: googleAdsConversionLabel }}>
    (function () {
      var CAT = {};
      var ID = {};
      providers.forEach(function (p) { CAT[p.key] = p.category; ID[p.key] = p.id; });
      var loaded = {};
      var hayGoogle = !!(ID.ga4 || ID.gtm || ID.googleAds);
      var KEYS = providers.map(function (p) { return p.key; });

      // REPLICA de consentCovers (src/lib/cookies.ts): un consentimiento solo vale
      // si cubre TODOS los proveedores encendidos ahora. Sin `providers` guardado
      // (cookie anterior a la versión) y con algún proveedor encendido → NO vale.
      // Analytics.test.ts ejecuta este código contra la función pura.
      function covers(c) {
        if (KEYS.length === 0) return true;
        if (!Array.isArray(c.providers)) return false;
        return KEYS.every(function (k) { return c.providers.indexOf(k) !== -1; });
      }

      function readConsent() {
        try {
          var match = document.cookie.split('; ').find(function (c) { return c.indexOf('cookie_consent=') === 0; });
          if (!match) return {};
          var c = JSON.parse(decodeURIComponent(match.split('=').slice(1).join('=')));
          if (!c || typeof c !== 'object' || !covers(c)) return {};
          return { analytics: c.analytics === true, marketing: c.marketing === true };
        } catch (e) {
          return {};
        }
      }
      function mode(v) { return v ? 'granted' : 'denied'; }
      function allowed(cat, c) {
        if (cat === 'analytics') return !!c.analytics;
        if (cat === 'marketing') return !!c.marketing;
        return !!(c.analytics || c.marketing); // 'any'
      }

      window.dataLayer = window.dataLayer || [];
      function gtag() { window.dataLayer.push(arguments); }
      window.gtag = window.gtag || gtag;

      if (hayGoogle) {
        // 1) Todo denegado ANTES de cualquier script de Google.
        gtag('consent', 'default', {
          analytics_storage: 'denied',
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          wait_for_update: 500,
        });
      }

      function script(src) {
        var s = document.createElement('script');
        s.async = true;
        s.src = src;
        var f = document.getElementsByTagName('script')[0];
        if (f && f.parentNode) f.parentNode.insertBefore(s, f); else document.head.appendChild(s);
      }

      var gtagJs = false;
      function ensureGtagJs(id) {
        if (gtagJs) return;
        gtagJs = true;
        script('https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(id));
        gtag('js', new Date());
      }

      var LOADERS = {
        ga4: function (id) { ensureGtagJs(id); gtag('config', id); window.gaLoaded = true; },
        googleAds: function (id) { ensureGtagJs(id); gtag('config', id); },
        gtm: function (id) {
          window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
          script('https://www.googletagmanager.com/gtm.js?id=' + encodeURIComponent(id));
          window.gtmLoaded = true;
        },
        metaPixel: function (id) {
          (function (f, b, e, v, n, t, s) {
            if (f.fbq) return;
            n = f.fbq = function () { n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments); };
            if (!f._fbq) f._fbq = n;
            n.push = n; n.loaded = true; n.version = '2.0'; n.queue = [];
            t = b.createElement(e); t.async = true; t.src = v;
            s = b.getElementsByTagName(e)[0]; s.parentNode.insertBefore(t, s);
          })(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
          window.fbq('init', id);
          window.fbq('track', 'PageView');
        },
        tiktokPixel: function (id) {
          var t = 'ttq';
          window.TiktokAnalyticsObject = t;
          var ttq = window[t] = window[t] || [];
          ttq.methods = ['page', 'track', 'identify', 'instances', 'debug', 'on', 'off', 'once', 'ready', 'alias', 'group', 'enableCookie', 'disableCookie'];
          ttq.setAndDefer = function (o, m) { o[m] = function () { o.push([m].concat(Array.prototype.slice.call(arguments, 0))); }; };
          for (var i = 0; i < ttq.methods.length; i++) ttq.setAndDefer(ttq, ttq.methods[i]);
          ttq._i = ttq._i || {}; ttq._i[id] = [];
          ttq._t = ttq._t || {}; ttq._t[id] = +new Date();
          script('https://analytics.tiktok.com/i18n/pixel/events.js?sdkid=' + encodeURIComponent(id) + '&lib=' + t);
          ttq.page();
        },
        linkedinPartnerId: function (id) {
          window._linkedin_data_partner_ids = window._linkedin_data_partner_ids || [];
          window._linkedin_data_partner_ids.push(id);
          script('https://snap.licdn.com/li.lms-analytics/insight.min.js');
        },
        clarity: function (id) {
          window.clarity = window.clarity || function () { (window.clarity.q = window.clarity.q || []).push(arguments); };
          script('https://www.clarity.ms/tag/' + encodeURIComponent(id));
        },
      };

      function apply(c) {
        if (!c.analytics && !c.marketing) return;
        if (hayGoogle) {
          gtag('consent', 'update', {
            analytics_storage: mode(c.analytics),
            ad_storage: mode(c.marketing),
            ad_user_data: mode(c.marketing),
            ad_personalization: mode(c.marketing),
          });
        }
        providers.forEach(function (p) {
          if (loaded[p.key] || !allowed(CAT[p.key], c) || !LOADERS[p.key]) return;
          loaded[p.key] = true;
          window.trackersLoaded = true;
          LOADERS[p.key](p.id);
        });
      }

      // Conversión. Solo a lo ya cargado. Devuelve las claves a las que llegó.
      var LEAD = { generate_lead: true };
      window.saastroTrack = function (name, data) {
        data = data || {};
        var sent = [];
        var eid = data.event_id;
        if (loaded.ga4) { gtag('event', name, data); sent.push('ga4'); }
        if (loaded.gtm) { window.dataLayer.push(Object.assign({ event: name }, data)); sent.push('gtm'); }
        if (loaded.googleAds && adsLabel && LEAD[name]) {
          gtag('event', 'conversion', { send_to: ID.googleAds + '/' + adsLabel });
          sent.push('googleAds');
        }
        if (loaded.metaPixel && window.fbq) {
          var opts = eid ? { eventID: eid } : undefined;
          if (LEAD[name]) window.fbq('track', 'Lead', {}, opts);
          else window.fbq('trackCustom', name, {}, opts);
          sent.push('metaPixel');
        }
        if (loaded.tiktokPixel && window.ttq) {
          window.ttq.track(LEAD[name] ? 'SubmitForm' : name, {}, eid ? { event_id: eid } : undefined);
          sent.push('tiktokPixel');
        }
        if (loaded.clarity && window.clarity) { window.clarity('event', name); sent.push('clarity'); }
        // LinkedIn: sus conversiones se definen por regla (id de conversión) en su
        // panel; sin ese id en settings no hay evento que emitir desde aquí.
        return sent;
      };

      // Navegaciones con ClientRouter: NO se emite page_view/PageView a mano. GA4
      // (medición mejorada, «cambios de página por el historial») y fbevents ya
      // escuchan pushState por su cuenta y un envío manual los duplicaría. Sin
      // medir en navegador no se sabe cuál de los dos casos es el real, así que
      // no se añade nada; la conversión (envío + /lp/gracias) es una carga completa.

      function start() {
        apply(readConsent());
        window.addEventListener('cookie-consent-updated', function (e) {
          var d = (e && e.detail) || {};
          apply({ analytics: d.analytics === true, marketing: d.marketing === true });
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', start);
      } else {
        start();
      }
    })();
  </script>
)}
