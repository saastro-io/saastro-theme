---
/**
 * FinalCta — sección `final`: el cierre de la home.
 * Local, por la misma razón que `CtaBanner`: la sección ES texto, y con
 * `cta-01` el titular de cierre quedaría fuera de Studio.
 */
import { Icon } from 'astro-icon/components';

interface Props {
  eyebrow?: string;
  title: string;
  code?: string;
  primaryCta: string;
  primaryHref: string;
  secondaryCta?: string;
  secondaryHref?: string;
  fieldPrefix?: string;
}

const {
  eyebrow,
  title,
  code,
  primaryCta,
  primaryHref,
  secondaryCta,
  secondaryHref,
  fieldPrefix = 'final',
} = Astro.props;
---

<section class="final">
  <div class="dot-grid final-dots" aria-hidden="true"></div>
  <div class="wrap final-in">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h2>{title}</h2>
    {code && <code>{code}</code>}
    <div class="ctas">
      <a class="ds-btn ds-btn-primary" href={primaryHref}>
        {primaryCta}
        <Icon name="tabler:arrow-right" aria-hidden="true" />
      </a>
      {secondaryCta && secondaryHref && (
        <a class="ds-btn ds-btn-secondary" href={secondaryHref} target="_blank" rel="noopener">
          {secondaryCta}
          <Icon name="tabler:arrow-up-right" aria-hidden="true" />
        </a>
      )}
    </div>
  </div>
</section>

<style>
  .final {
    position: relative;
    padding: 96px 0;
    border-top: 1px solid var(--ds-border);
    overflow: hidden;
    text-align: center;
  }
  .final-dots {
    opacity: 0.45;
    -webkit-mask-image: radial-gradient(ellipse 60% 70% at 50% 50%, oklch(0 0 0) 20%, transparent 100%);
    mask-image: radial-gradient(ellipse 60% 70% at 50% 50%, oklch(0 0 0) 20%, transparent 100%);
  }
  .final-in {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 24px;
  }
  h2 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(34px, 5vw, 56px);
    line-height: 1.04;
    letter-spacing: -0.03em;
    margin: 0;
    max-width: 820px;
    text-wrap: balance;
  }
  code {
    font-family: var(--ds-font-mono);
    font-size: 13px;
    background: var(--ds-bg-elevated);
    box-shadow: var(--ds-shadow-ring);
    padding: 8px 12px;
    border-radius: 6px;
    color: var(--ds-fg-muted);
  }
  .ctas {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
  }
  @media (max-width: 560px) {
    .final { padding: 64px 0; }
    .ctas { flex-direction: column; align-self: stretch; width: 100%; }
    .ctas .ds-btn { width: 100%; }
  }
</style>
