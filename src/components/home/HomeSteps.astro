---
/**
 * HomeSteps — sección `how` de la home comercial.
 *
 * Local y no `steps-01`: el diseño pide el número grande y apagado sobre un
 * filete de tinta, que el bloque no pinta, y con `steps-01` los pasos no
 * serían editables (lo que cruza a un bloque no se instrumenta). El número es
 * POSICIÓN, no contenido: sale del índice, igual que en `steps-01`.
 */
interface Props {
  eyebrow?: string;
  title: string;
  steps: { title: string; description: string }[];
  fieldPrefix?: string;
}

const { eyebrow, title, steps, fieldPrefix = 'how' } = Astro.props;
---

<section class="sec" id="how">
  <div class="wrap">
    <div class="sec-head">
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      <h2>{title}</h2>
    </div>
    <ol class="steps">
      {steps.map((step, i) => (
        <li class="step">
          <span class="n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3>{step.title}</h3>
          <p>{step.description}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .step {
    padding-top: 28px;
    border-top: 1px solid var(--ds-fg);
    display: grid;
    gap: 12px;
    align-content: start;
  }
  .n {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 56px;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--ds-fg-faint);
  }
  h3 {
    font-size: 22px;
    font-weight: 600;
    margin: 0;
    letter-spacing: -0.015em;
  }
  p {
    color: var(--ds-fg-muted);
    text-wrap: pretty;
  }
  @media (max-width: 820px) {
    .steps { grid-template-columns: 1fr; }
  }
</style>
