---
/**
 * ValuesGrid — ADAPTADOR de una sección de «manifiesto + tarjetas de valor».
 *
 *   bloque    src/components/blocks/features-01.astro — pristine del registry.
 *   adaptador este fichero.
 *   contenido i18n, namespace = `fieldPrefix`.
 *
 * Mismo reparto que el resto (ver `knowledge/src.md`): la cabecera y el párrafo
 * de manifiesto los pinta este fichero —y por eso son editables—, las tarjetas
 * las pinta el bloque y hoy no lo son.
 *
 * Es el MISMO bloque que usa `AboutContent`. Se escribe un adaptador aparte en
 * vez de reutilizar aquél porque `AboutContent` es la página About entera
 * (portada + misión + valores); esto es una sección suelta de la home. Compartir
 * el bloque es el modelo; compartir el adaptador sería atar dos páginas.
 */
import Features01 from '@/components/blocks/features-01.astro';

interface Item {
  title: string;
  description: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  /** Párrafo largo opcional bajo el subtítulo: el «manifiesto». */
  manifesto?: string;
  items: Item[];
  fieldPrefix?: string;
}

const { eyebrow, title, description, manifesto, items, fieldPrefix = 'manifesto' } = Astro.props;

// El bloque pinta una rejilla FIJA de 3 columnas (sm:2, lg:3) y no se edita
// aquí (es pristine del registry). Con menos de 3 tarjetas quedaría una rejilla
// coja alineada a la izquierda, así que el adaptador estrecha el contenedor y
// ajusta las columnas al número de tarjetas, desde fuera, con variantes de
// descendiente sobre la `class` que el bloque sí acepta.
const ajuste =
  items.length === 1
    ? '[&>div]:max-w-md sm:[&_.grid]:grid-cols-1 lg:[&_.grid]:grid-cols-1'
    : items.length === 2
      ? '[&>div]:max-w-4xl lg:[&_.grid]:grid-cols-2'
      : '';
---

<div class="border-t py-24 md:py-32">
  <div class="mx-auto max-w-3xl px-6 text-center">
    {eyebrow && (
      <p class="mb-4 text-sm font-semibold tracking-wider text-primary uppercase">{eyebrow}</p>
    )}
    <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">{title}</h2>
    {description && <p class="mt-4 text-lg text-muted-foreground">{description}</p>}
    {manifesto && <p class="mt-6 text-lg leading-relaxed">{manifesto}</p>}
  </div>

  <Features01 features={items} class={`py-0 pt-12 md:pt-16 ${ajuste}`.trim()} />
</div>
