---
/**
 * `POST /__render` — un bloque suelto, para la vista previa del Hub.
 *
 * Cuerpo `{ v:1, siteId, locale, slug?, tema?, block:{id,type,variant?,props} }`,
 * firmado por el Hub en `x-saastro-sig` (src/lib/pages/firma.ts) o, en el
 * render DIRECTO del navegador, con el token de vista previa en `x-saastro-pv`
 * (`slug` obligatorio) y CORS solo para `PAGES_HUB_ORIGIN`
 * (src/lib/pages/handlers.ts, donde está el contrato entero). Responde SOLO el HTML
 * del bloque (página parcial: sin <html>, sin layout), que el puente de la
 * vista previa inserta con `createContextualFragment` para que corran los
 * scripts de las islas. 400 con los errores de Zod o con un `siteId` que no es
 * `PAGES_SITE_ID`; 401 firma mala; 404 si el site no tiene `PAGES_RENDER_SECRET`
 * o `PAGES_SITE_ID`.
 */
import RenderBlocks from '../components/pages/RenderBlocks.astro';
import { CABECERA_FASES_MS, prepareRender, serverTiming } from '../lib/pages/handlers';
import { pagesRuntime } from '../lib/pages/runtime';
import { locales } from '../i18n/config';

export const partial = true;
export const prerender = false;

const rt = pagesRuntime(Astro.locals);
const job = await prepareRender(Astro.request, rt.secret, rt.siteIdFirmado, locales, { hubOrigin: rt.hubOrigin });
if (job instanceof Response) return job;

for (const [k, v] of Object.entries(job.cors)) Astro.response.headers.set(k, v);
Astro.response.headers.set('cache-control', 'no-store');
Astro.response.headers.set('x-robots-tag', 'noindex');
// `firma` (HMAC del Hub o token del navegador, según `auth`) aquí; `render`,
// `total` e `isolate` los añade timing-middleware.ts.
Astro.response.headers.set(
  'server-timing',
  serverTiming([{ name: 'firma', dur: job.firmaMs }, { name: 'auth', desc: job.auth }, { name: 'tema', desc: job.tema }]),
);
Astro.response.headers.set(CABECERA_FASES_MS, String(job.firmaMs));
---

<RenderBlocks blocks={[job.block]} tema={job.tema} locale={job.locale} bare />
