---
/**
 * `POST /__render` — un bloque suelto, para la vista previa del Hub.
 *
 * Cuerpo `{ v:1, siteId, locale, tema?, block:{id,type,variant?,props} }`,
 * firmado en `x-saastro-sig` (src/lib/pages/firma.ts). Responde SOLO el HTML
 * del bloque (página parcial: sin <html>, sin layout), que el puente de la
 * vista previa inserta con `createContextualFragment` para que corran los
 * scripts de las islas. 400 con los errores de Zod o con un `siteId` que no es
 * `PAGES_SITE_ID`; 401 firma mala; 404 si el site no tiene `PAGES_RENDER_SECRET`
 * o `PAGES_SITE_ID`.
 */
import RenderBlocks from '../components/pages/RenderBlocks.astro';
import { CABECERA_FASES_MS, prepareRender, serverTiming } from '../lib/pages/handlers';
import { pagesRuntime } from '../lib/pages/runtime';
import { locales } from '../i18n/config';

export const partial = true;
export const prerender = false;

const rt = pagesRuntime(Astro.locals);
const job = await prepareRender(Astro.request, rt.secret, rt.siteIdFirmado, locales);
if (job instanceof Response) return job;

Astro.response.headers.set('cache-control', 'no-store');
Astro.response.headers.set('x-robots-tag', 'noindex');
// `firma` aquí; `render`, `total` e `isolate` los añade timing-middleware.ts.
Astro.response.headers.set('server-timing', serverTiming([{ name: 'firma', dur: job.firmaMs }, { name: 'tema', desc: job.tema }]));
Astro.response.headers.set(CABECERA_FASES_MS, String(job.firmaMs));
---

<RenderBlocks blocks={[job.block]} tema={job.tema} locale={job.locale} bare />
