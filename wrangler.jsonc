{
  "name": "saastro-theme",
  "main": "src/worker.ts",
  "compatibility_date": "2026-04-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    // El Worker (src/worker.ts) ve primero todo salvo /_astro/ (el grueso del peso):
    // es lo que deja a la «página en construcción» cubrir las páginas prerenderizadas.
    // NO excluir «!/*.*»: medido, rutas con punto del Worker como /__blocks.json
    // (critical-css-check) dejan de llegar a él. Lo estático con punto lo sirve
    // handle() desde ASSETS; la puerta lo deja pasar sin tocar el Hub.
    "run_worker_first": ["/*", "!/_astro/*"]
  },

  // «Páginas como datos» (`pages` en astro.config.mjs). Solo el origen del Hub,
  // que no es secreto. `PAGES_RENDER_SECRET` (secreto) y `PAGES_SITE_ID` NO van
  // aquí: se ponen en el Worker (`wrangler secret put` / Variables del
  // dashboard). Sin ellos `/__render`, `/__purge`, `/__blocks.json` y `?__pv`
  // responden 404: el theme sirve lo mismo que antes.
  "vars": {
    "PAGES_HUB_ORIGIN": "https://hub.saastro.io",
    // Origen del Hub que lee `loadPage` (vista previa de borradores en Studio).
    // Sin él cae a la fixture y un borrador como es/home2 da 404.
    "PAGES_ORIGIN": "https://hub.saastro.io"
  },

  // Encendida en ESTE worker (la plantilla): sin logs no se podía ver por qué
  // la vista previa daba 404. OJO: Workers Observability guarda la URL de cada
  // petición; un descendiente cuyo HTML lleve URLs con token (p. ej.
  // /shared/<token>) debe ponerla en false. Aquí solo cae en logs el
  // `?preview=<token>` de /lp/<slug> (firmado por el Hub, caduca): riesgo
  // aceptado por el encargo 01M666MVB2.
  "observability": {
    "enabled": true
  }
}
