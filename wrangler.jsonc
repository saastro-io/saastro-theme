{
  "name": "saastro-theme",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-04-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },

  // Apagada de serie: con los logs encendidos, Workers Observability guarda la
  // URL de cada petición, y un site cuyo HTML lleve URLs con token (p. ej.
  // /shared/<token>) los dejaría escritos en el dashboard de Cloudflare.
  // Enciéndela (true) solo si el site la necesita y sus URLs no llevan nada
  // secreto: la medición render-vs-JS con `sink: 'log'` (settings.measure.renderRatio)
  // escribe en estos logs y `pnpm ratio` los lee; con false no registra nada.
  "observability": {
    "enabled": false
  },

  // SOLO en la rama `proto/paginas-datos` (no se mergea): el Worker de pruebas
  // de «páginas como datos». Va detrás de un entorno para que el build normal
  // —el de CI y el de cualquier descendiente— no pida un service binding que no
  // existe. Se construye con `CLOUDFLARE_ENV=pruebas pnpm build` y se despliega
  // con `wrangler deploy --config dist/server/wrangler.json`.
  // `vars` y `services` NO se heredan del nivel de arriba: van aquí enteros.
  // El secreto va aparte: `wrangler secret put PAGES_RENDER_SECRET --env pruebas`.
  "env": {
    "pruebas": {
      "services": [{ "binding": "HUB", "service": "saastro-hub-react" }],
      "vars": {
        "TEMA_BY_HOST": "{\"prototipo-b.enlolab.com\":\"b\"}"
      }
    }
  }
}
