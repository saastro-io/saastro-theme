{
  "name": "experimento-tailwind-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "assets": "node scripts/empaquetar-assets.mjs",
    "dev": "wrangler dev --port 8799",
    "dry-run": "wrangler deploy --dry-run --outdir out --metafile out/meta.json && node scripts/desglose-bundle.mjs",
    "tiempos": "node scripts/medir-tiempos.mjs",
    "tiempos:node": "node scripts/medir-node.mjs",
    "comparar": "node scripts/comparar.mjs",
    "manifiesto": "node scripts/validar-manifiesto.mjs",
    "seguridad": "node scripts/seguridad.mjs && node scripts/peor-caso-con-topes.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "marked": "18.1.1",
    "playwright-core": "1.56.1",
    "shadcn": "4.21.4",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "wrangler": "4.149.0"
  }
}
