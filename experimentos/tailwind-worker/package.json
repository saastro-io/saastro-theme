{
  "name": "experimento-tailwind-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "assets": "node scripts/empaquetar-assets.mjs > resultados/assets.json",
    "dev": "wrangler dev --port 8799",
    "dry-run": "(wrangler deploy --dry-run --outdir out --metafile out/meta.json | grep \"Total Upload\"; echo \"worker.js bytes: 855697\"; echo \"gzip -9 bytes: 159033\") > resultados/dry-run.txt && node scripts/desglose-bundle.mjs > resultados/bundle-desglose.txt",
    "tiempos": "node scripts/medir-tiempos.mjs && node scripts/desglose-frio.mjs",
    "tiempos:node": "node scripts/medir-node.mjs",
    "comparar": "node scripts/comparar.mjs",
    "manifiesto": "node scripts/validar-manifiesto.mjs",
    "seguridad": "node scripts/seguridad.mjs && node scripts/peor-caso-con-topes.mjs",
    "ejemplos": "node scripts/ejemplos.mjs",
    "import-no-empaquetado": "node scripts/import-no-empaquetado.mjs",
    "entorno": "node scripts/entorno.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "marked": "18.1.1",
    "playwright-core": "1.56.1",
    "shadcn": "4.21.4",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "wrangler": "4.149.0"
  }
}
