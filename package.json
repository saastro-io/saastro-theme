{
  "name": "saastro-theme",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "typecheck": "astro check",
    "test": "vitest run",
    "ui:check": "node scripts/ui-check.mjs",
    "ui:sync": "node scripts/ui-sync.mjs",
    "studio:check": "node scripts/cabeceras-check.mjs && node scripts/studio-check.mjs && PUBLIC_SAASTRO_I18N_READS=1 astro build && node scripts/studio-contract-check.mjs && node scripts/cabeceras-worker-check.mjs",
    "studio:contract:update": "PUBLIC_SAASTRO_I18N_READS=1 astro build && node scripts/studio-contract-check.mjs --update",
    "ratio": "node scripts/ratio.mjs",
    "deploy": "pnpm run build && wrangler deploy --config dist/server/wrangler.json",
    "preview": "astro preview",
    "astro": "astro",
    "sync-secrets": "node scripts/sync-secrets.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/react": "^6.0.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@iconify-json/tabler": "^1.2.41",
    "@iconify/react": "^6.0.2",
    "@saastro/forms": "^0.21.0",
    "astro": "^7.3.5",
    "astro-icon": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^0.577.0",
    "react": "^19.3.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "shadcn": "^4.21.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@saastro/studio": "0.10.2",
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "node-html-parser": "^9.0.4",
    "puppeteer": "^24.43.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  }
}
